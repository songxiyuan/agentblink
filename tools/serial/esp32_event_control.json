{
  "default": {
    "light": {
      "command": [
        "off"
      ]
    }
  },
  "events": {
    "PermissionRequest": {
      "light": {
        "command": [
          "solid",
          "225",
          "121",
          "35",
          "0"
        ],
        "description": "Yellow breathing light"
      },
      "buzzer": {
        "command": [
          "beep",
          "2000",
          "200"
        ],
        "description": "Short 2000 Hz beep for 200 ms"
      },
      "vibration": {
        "command": [
          "vibrate",
          "500"
        ],
        "description": "Short vibration for 500 ms"
      }
    },
    "UserPromptSubmit": {
      "light": {
        "command": [
          "chase"
        ]
      }
    },
    "Stop": {
      "light": {
        "command": [
          "solid",
          "0",
          "255",
          "0",
          "0"
        ]
      }
    },
    "SessionStart": {
      "light": {
        "command": [
          "off"
        ]
      }
    },
    "SessionEnd": {
      "light": {
        "command": [
          "off"
        ]
      }
    }
  }
}
